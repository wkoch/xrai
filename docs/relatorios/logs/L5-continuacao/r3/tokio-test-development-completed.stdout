","source_hash":"6f0d4644be7609262a9666273ad511aaa4ad526c63ab9edce9e30cad0769a7d7","start":1209,"end":1213}},{"id":"sym_42abbceab56dcf85fa3233bda53fa47d2f3c591c4616a3a67c1cb3688ee3da93","name":"Action","module":"io","namespace":"type","kind":"enum_item","visibility":"private","evidence":{"file_id":"fi_71227cc5d6c9e43690e4697423a2558f31cc95e622811768d8782e055cc1511a","snapshot_id":"snap_966ee015a8d80a9acbedbf9704aa05a20a58a0a3da07bad3bc43a00548439841","path":"tokio-test/src/io.rs","source_hash":"6f0d4644be7609262a9666273ad511aaa4ad526c63ab9edce9e30cad0769a7d7","start":1591,"end":1597}},{"id":"sym_5d51a54f15db9dfd827aa0689d4c951439adbf91dcdadb09ed929ac38845ec54","name":"PanicMsgSnippet","module":"io","namespace":"value","kind":"struct_item","visibility":"private","evidence":{"file_id":"fi_71227cc5d6c9e43690e4697423a2558f31cc95e622811768d8782e055cc1511a","snapshot_id":"snap_966ee015a8d80a9acbedbf9704aa05a20a58a0a3da07bad3bc43a00548439841","path":"tokio-test/src/io.rs","source_hash":"6f0d4644be7609262a9666273ad511aaa4ad526c63ab9edce9e30cad0769a7d7","start":17529,"end":17544}},{"id":"sym_71b96d8223b497d497c5a9806fa6ff6323bd37818494400509dbf58490b0472f","name":"VTABLE","module":"task","namespace":"value","kind":"static_item","visibility":"private","evidence":{"file_id":"fi_b6afcc273eb8497c6a65c1639b7eedc2ee59d7fc9617dd10ee28045126bc9267","snapshot_id":"snap_966ee015a8d80a9acbedbf9704aa05a20a58a0a3da07bad3bc43a00548439841","path":"tokio-test/src/task.rs","source_hash":"88777a808a119659784644b4c9056af1100ffce437a9ec5d2f7c4f4bdc670a87","start":7863,"end":7869}},{"id":"sym_7dced571e054e2f53fc3e15cf57e496d574a426d2bb2e966987b5a940012e893","name":"drop_waker","module":"task","namespace":"value","kind":"function_item","visibility":"private","evidence":{"file_id":"fi_b6afcc273eb8497c6a65c1639b7eedc2ee59d7fc9617dd10ee28045126bc9267","snapshot_id":"snap_966ee015a8d80a9acbedbf9704aa05a20a58a0a3da07bad3bc43a00548439841","path":"tokio-test/src/task.rs","source_hash":"88777a808a1196597