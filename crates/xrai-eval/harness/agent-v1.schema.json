{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xrai.local/eval/agent-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "xrai.eval.agent.v1"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "arm": {
          "type": "string"
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "effort": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "name",
            "version",
            "effort"
          ],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "config_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "config_sha256"
          ],
          "additionalProperties": false
        },
        "run_id": {
          "type": "string"
        },
        "price": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "currency": {
              "const": "USD"
            },
            "unit": {
              "const": "micro_usd_per_token"
            },
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "version",
            "source",
            "date",
            "currency",
            "unit",
            "input",
            "output"
          ],
          "additionalProperties": false
        },
        "setup_amortization": {
          "type": "object",
          "properties": {
            "regime": {
              "type": "string"
            },
            "uses": {
              "type": "integer",
              "minimum": 1
            },
            "gross_micro_usd": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "regime",
            "uses",
            "gross_micro_usd"
          ],
          "additionalProperties": false
        },
        "credentials": {
          "const": "never-recorded"
        }
      },
      "required": [
        "task_id",
        "dataset_sha256",
        "arm",
        "model",
        "policy",
        "run_id",
        "price",
        "setup_amortization",
        "credentials"
      ],
      "additionalProperties": false
    },
    "budget_micro_usd": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "reserve",
              "reject",
              "send",
              "chunk",
              "finish",
              "receipt"
            ]
          },
          "attempt_id": {
            "type": "string"
          },
          "monotonic_seconds": {
            "type": "number",
            "minimum": 0
          },
          "details": {
            "type": "object"
          },
          "previous_event_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sequence",
          "kind",
          "attempt_id",
          "monotonic_seconds",
          "details",
          "previous_event_sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "reserve",
                    "reject"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "details": {
                  "type": "object",
                  "properties": {
                    "call_id": {
                      "type": "string"
                    },
                    "request": {
                      "type": "object",
                      "properties": {
                        "orientation": {
                          "type": "string"
                        },
                        "tool_definitions": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "messages": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "tool_calls": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "expansions": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "edits": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "tests": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "limits": {
                          "type": "object",
                          "properties": {
                            "input_tokens": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "output_tokens": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "input_tokens",
                            "output_tokens"
                          ],
                          "additionalProperties": false
                        },
                        "maximum_charge_policy": {
                          "const": "fake-enforced"
                        }
                      },
                      "required": [
                        "orientation",
                        "tool_definitions",
                        "messages",
                        "tool_calls",
                        "expansions",
                        "edits",
                        "tests",
                        "limits",
                        "maximum_charge_policy"
                      ],
                      "additionalProperties": false
                    },
                    "max_charge_micro_usd": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "retry_of": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "call_id",
                    "request",
                    "max_charge_micro_usd",
                    "retry_of"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "send"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "details": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "chunk"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "details": {
                  "type": "object",
                  "properties": {
                    "base64": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "captured_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "truncated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "base64",
                    "sha256",
                    "captured_bytes",
                    "observed_bytes",
                    "truncated"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "finish"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "details": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "enum": [
                        "reserved",
                        "sent",
                        "streaming",
                        "completed",
                        "timeout",
                        "cancelled",
                        "partial",
                        "sent_no_response",
                        "rejected_before_send"
                      ]
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "receipt"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "details": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string"
                    },
                    "provider_receipt_id": {
                      "type": "string"
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "output_tokens": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "cached_input_tokens": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "reasoning_output_tokens": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "input_tokens",
                        "output_tokens",
                        "cached_input_tokens",
                        "reasoning_output_tokens"
                      ],
                      "additionalProperties": false
                    },
                    "category_semantics": {
                      "type": "object",
                      "properties": {
                        "cached_input_tokens": {
                          "const": "subset_of_input_tokens"
                        },
                        "reasoning_output_tokens": {
                          "const": "subset_of_output_tokens"
                        }
                      },
                      "required": [
                        "cached_input_tokens",
                        "reasoning_output_tokens"
                      ],
                      "additionalProperties": false
                    },
                    "price_version": {
                      "type": "string"
                    },
                    "estimated_charge_micro_usd": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_charge_micro_usd": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_charge_source": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "provider_receipt_id",
                    "usage",
                    "category_semantics",
                    "price_version",
                    "estimated_charge_micro_usd",
                    "observed_charge_micro_usd",
                    "observed_charge_source"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "call_id": {
            "type": "string"
          },
          "retry_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "request": {
            "type": "object",
            "properties": {
              "base64": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "captured_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "observed_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "base64",
              "sha256",
              "captured_bytes",
              "observed_bytes",
              "truncated"
            ],
            "additionalProperties": false
          },
          "state": {
            "enum": [
              "reserved",
              "sent",
              "streaming",
              "completed",
              "timeout",
              "cancelled",
              "partial",
              "sent_no_response",
              "rejected_before_send"
            ]
          },
          "sent": {
            "type": "boolean"
          },
          "response_chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "base64": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "captured_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "observed_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "base64",
                "sha256",
                "captured_bytes",
                "observed_bytes",
                "truncated"
              ],
              "additionalProperties": false
            }
          },
          "receipt": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string"
                  },
                  "provider_receipt_id": {
                    "type": "string"
                  },
                  "usage": {
                    "type": "object",
                    "properties": {
                      "input_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "output_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "cached_input_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "reasoning_output_tokens": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "input_tokens",
                      "output_tokens",
                      "cached_input_tokens",
                      "reasoning_output_tokens"
                    ],
                    "additionalProperties": false
                  },
                  "category_semantics": {
                    "type": "object",
                    "properties": {
                      "cached_input_tokens": {
                        "const": "subset_of_input_tokens"
                      },
                      "reasoning_output_tokens": {
                        "const": "subset_of_output_tokens"
                      }
                    },
                    "required": [
                      "cached_input_tokens",
                      "reasoning_output_tokens"
                    ],
                    "additionalProperties": false
                  },
                  "price_version": {
                    "type": "string"
                  },
                  "estimated_charge_micro_usd": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "observed_charge_micro_usd": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "observed_charge_source": {
                    "type": "string"
                  }
                },
                "required": [
                  "provider",
                  "provider_receipt_id",
                  "usage",
                  "category_semantics",
                  "price_version",
                  "estimated_charge_micro_usd",
                  "observed_charge_micro_usd",
                  "observed_charge_source"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "reservation_micro_usd": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "call_id",
          "retry_of",
          "request",
          "state",
          "sent",
          "response_chunks",
          "receipt",
          "reservation_micro_usd"
        ],
        "additionalProperties": false
      }
    },
    "accounting": {
      "type": "object",
      "properties": {
        "known_observed_charge_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "retained_reservation_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "budget_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_charge_attempts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_cost_complete": {
          "type": "boolean"
        },
        "observed_cost_micro_usd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "supported_cost_interval_micro_usd": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "reservation_is_provider_charge_guarantee": {
          "const": false
        },
        "budget_limit_respected": {
          "type": "boolean"
        }
      },
      "required": [
        "known_observed_charge_micro_usd",
        "retained_reservation_micro_usd",
        "budget_micro_usd",
        "unknown_charge_attempts",
        "observed_cost_complete",
        "observed_cost_micro_usd",
        "supported_cost_interval_micro_usd",
        "reservation_is_provider_charge_guarantee",
        "budget_limit_respected"
      ],
      "additionalProperties": false
    },
    "events_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "budget_incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string"
          },
          "reserved_maximum_micro_usd": {
            "type": "integer",
            "minimum": 0
          },
          "observed_charge_micro_usd": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "attempt_id",
          "reserved_maximum_micro_usd",
          "observed_charge_micro_usd",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "outcome": {
      "const": "not_judged"
    },
    "adapter": {
      "const": "fake-offline-v1"
    },
    "paid_provider_called": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "metadata",
    "budget_micro_usd",
    "events",
    "attempts",
    "accounting",
    "events_sha256",
    "budget_incidents",
    "outcome",
    "adapter",
    "paid_provider_called"
  ],
  "additionalProperties": false
}
