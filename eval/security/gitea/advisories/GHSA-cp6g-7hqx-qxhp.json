{"ghsa_id":"GHSA-cp6g-7hqx-qxhp","cve_id":"CVE-2026-2303","url":"https://api.github.com/advisories/GHSA-cp6g-7hqx-qxhp","html_url":"https://github.com/advisories/GHSA-cp6g-7hqx-qxhp","summary":"mongo-go-driver has Heap Out-of-Bounds Read in GSSAPI Error Handling","description":"The mongo-go-driver repository contains CGo bindings for GSSAPI (Kerberos) authentication on Linux and macOS. The C wrapper implementation contains a heap out-of-bounds read vulnerability due to incorrect assumptions about string termination in the GSSAPI standard. Since GSSAPI buffers are not guaranteed to be null-terminated or have extra padding, this results in reading one byte past the allocated heap buffer.","type":"reviewed","severity":"medium","repository_advisory_url":null,"source_code_location":"https://github.com/mongodb/mongo-go-driver","identifiers":[{"value":"GHSA-cp6g-7hqx-qxhp","type":"GHSA"},{"value":"CVE-2026-2303","type":"CVE"}],"references":["https://nvd.nist.gov/vuln/detail/CVE-2026-2303","https://jira.mongodb.org/browse/GODRIVER-3770","https://github.com/advisories/GHSA-cp6g-7hqx-qxhp"],"published_at":"2026-02-10T21:31:31Z","updated_at":"2026-06-18T13:02:30Z","github_reviewed_at":"2026-06-18T13:02:29Z","nvd_published_at":"2026-02-10T20:17:00Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"go","name":"go.mongodb.org/mongo-driver"},"vulnerable_version_range":"< 1.17.7","first_patched_version":"1.17.7","vulnerable_functions":[]},{"package":{"ecosystem":"go","name":"go.mongodb.org/mongo-driver/v2"},"vulnerable_version_range":"< 2.4.2","first_patched_version":"2.4.2","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:N","score":6.5},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:P/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N","score":6.9}},"cwes":[{"cwe_id":"CWE-183","name":"Permissive List of Allowed Inputs"}],"credits":[{"user":{"login":"OddBloke","id":62736,"node_id":"MDQ6VXNlcjYyNzM2","avata