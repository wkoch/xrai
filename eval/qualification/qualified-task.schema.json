{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xrai.dev/eval/qualified-task-v1",
  "title": "ADR021 qualified primary task; cross-row rules enforced by verify_qualified.py",
  "type": "object",
  "required": [
    "id",
    "version",
    "dataset",
    "family",
    "kind",
    "language",
    "repository",
    "change_lineage",
    "derived_from",
    "origin",
    "input",
    "production_modules",
    "relations",
    "complexity",
    "snapshot_proof",
    "oracle_receipt",
    "review_receipt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^Q1-"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "dataset": {
      "const": "qualified"
    },
    "family": {
      "enum": [
        "Rust",
        "TSJS",
        "Python",
        "Go"
      ]
    },
    "kind": {
      "enum": [
        "correction",
        "contract_change",
        "state_config",
        "review",
        "control"
      ]
    },
    "language": {
      "enum": [
        "Rust",
        "TypeScript",
        "JavaScript",
        "Python",
        "Go"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "change_lineage": {
      "type": "string",
      "minLength": 1
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "origin": {
      "type": "object",
      "required": [
        "class",
        "url",
        "motivation"
      ],
      "properties": {
        "class": {
          "enum": [
            "public_change",
            "controlled_real_use",
            "control"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "motivation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "prompt",
        "snapshot"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "context_policy": {
          "type": "object"
        },
        "state_changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state_change"
          }
        },
        "agent_input_allowlist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_diff": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "production_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "subsystem",
          "necessity"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "subsystem": {
            "type": "string",
            "minLength": 1
          },
          "necessity": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "complexity": {
      "type": "object",
      "required": [
        "complex"
      ],
      "properties": {
        "complex": {
          "type": "boolean"
        }
      }
    },
    "snapshot_proof": {
      "type": "object",
      "required": [
        "commit",
        "archive",
        "complete_checkout",
        "license_files",
        "measurement_method",
        "exclusions",
        "production_files",
        "production_nonempty_lines"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "archive": {
          "$ref": "#/$defs/artifact"
        },
        "complete_checkout": {
          "const": true
        },
        "license_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "production_files": {
          "type": "integer",
          "minimum": 0
        },
        "production_nonempty_lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "oracle_receipt": {
      "$ref": "#/$defs/artifact"
    },
    "review_receipt": {
      "type": "object",
      "required": [
        "author",
        "second_reader",
        "status",
        "prompt_sha256",
        "oracle_sha256",
        "findings",
        "corrections",
        "evidence"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "second_reader": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "accepted"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "oracle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "findings": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "corrections": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "evidence": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "probe_receipt": {
      "type": "object",
      "required": [
        "baseline",
        "reference",
        "regression",
        "evidence"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/process"
        },
        "reference": {
          "$ref": "#/$defs/process"
        },
        "regression": {
          "$ref": "#/$defs/process"
        },
        "evidence": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "review_oracle": {
      "type": "object",
      "required": [
        "blind_adjudication",
        "unexpected_findings_require_reproduction",
        "defects"
      ],
      "properties": {
        "blind_adjudication": {
          "const": true
        },
        "unexpected_findings_require_reproduction": {
          "const": true
        },
        "defects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        }
      }
    },
    "configuration_oracle": {
      "type": "object",
      "required": [
        "facts",
        "alternate_valid_evidence_allowed"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "alternate_valid_evidence_allowed": {
          "const": true
        }
      }
    },
    "incremental_event": {
      "type": "object",
      "required": [
        "sequence",
        "same_process_required",
        "oracle_B",
        "full_rebuild_comparison"
      ],
      "properties": {
        "sequence": {
          "const": [
            "materialize_A",
            "start_index_A",
            "warm_query",
            "apply_B",
            "same_index_query",
            "oracle_B",
            "full_rebuild_B"
          ]
        },
        "same_process_required": {
          "const": true
        },
        "oracle_B": {
          "$ref": "#/$defs/artifact"
        },
        "full_rebuild_comparison": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "required": [
        "exit_code",
        "command",
        "environment"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "state_change": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "write",
            "remove"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "content": {
          "type": "string"
        },
        "preserve_mtime": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "write"
              }
            }
          },
          "then": {
            "required": [
              "content"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "const": "Rust"
          }
        },
        "required": [
          "family"
        ]
      },
      "then": {
        "properties": {
          "language": {
            "enum": [
              "Rust"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "TSJS"
          }
        },
        "required": [
          "family"
        ]
      },
      "then": {
        "properties": {
          "language": {
            "enum": [
              "TypeScript",
              "JavaScript"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "Python"
          }
        },
        "required": [
          "family"
        ]
      },
      "then": {
        "properties": {
          "language": {
            "enum": [
              "Python"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "Go"
          }
        },
        "required": [
          "family"
        ]
      },
      "then": {
        "properties": {
          "language": {
            "enum": [
              "Go"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "correction",
              "contract_change"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "probe_receipt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "review"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "review_oracle"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "state_config"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "configuration_oracle"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "control"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "complexity": {
            "properties": {
              "complex": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
